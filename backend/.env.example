# Copy this file to .env and fill in your own values. NEVER commit the real .env file.
PORT=8000
MONGODB_URL=
# long random value, 64+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# comma separated list of allowed frontend URLs (add your deployed site here)
CLIENT_URLS=http://localhost:5173
# Firebase project id used to verify Google sign-in tokens
FIREBASE_PROJECT_ID=learnify-35b0f
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OTP emails - RECOMMENDED: Brevo (free plan, 300 emails/day). Create an API key in Brevo (SMTP & API -> API Keys)
# and verify your sender address there (Senders & IP -> Senders). Works over HTTPS, so it also works on Render etc.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Learnify
# Fallback when BREVO_API_KEY is empty: a Gmail address + app password
EMAIL=
EMAIL_PASS=
# new accounts must confirm their email with a code (true). Set to false only for local development without mail.
REQUIRE_EMAIL_VERIFICATION=true
# optional: separate secret for hashing one-time codes (falls back to JWT_SECRET)
OTP_SECRET=
# lecture videos / notes on Cloudinary as private files (see ASSIGNMENT_SYSTEM.md); turn on after a real upload test
PRIVATE_MEDIA=false
# students' submitted PDFs are private by default; "false" only to go back to public links
PRIVATE_ASSIGNMENT_FILES=true
# payments stay off until Razorpay is set up; then set RAZORPAY_ENABLED=true
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# production only: NODE_ENV=production (cookies become Secure + SameSite=None, proxy IPs are trusted)

# Set false to skip the DNS mail-server check (typo + disposable checks stay on)
EMAIL_MX_CHECK=true
